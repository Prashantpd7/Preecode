// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"label": "Preecode: Compile Extension",
			"script": "compile",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			// Opens the Extension Development Host as a normal VS Code window.
			// This bypasses the `extensionHost` debug type, which always starts the
			// dev host's extension host paused at `--inspect-brk` and only works if
			// the JS debugger can attach to it.
			"label": "Preecode: Open Extension Development Host",
			"type": "shell",
			"command": "code",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"problemMatcher": []
		}
	]
}
