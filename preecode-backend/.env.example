PORT=
MONGO_URI=
JWT_SECRET=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=production

# Optional for local frontend development only.
FRONTEND_DEV_URL=

# Optional when serving static assets from the backend.
FRONTEND_STATIC_PATH=

# Required for Google OAuth callback generation unless GOOGLE_CALLBACK_URL is set explicitly.
BACKEND_URL=

# Optional explicit override for Google OAuth callback.
GOOGLE_CALLBACK_URL=

# AI providers — z.ai (primary) with NVIDIA NIM fallback.
# Get a free z.ai key at https://z.ai/manage-apikey/apikey-list (no card needed)
# Get a free NVIDIA key at https://build.nvidia.com (no card needed)
ZAI_API_KEY=
# Optional overrides (defaults shown):
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.7-flash
# ZAI_FALLBACK_MODEL=glm-4.5-flash
NVIDIA_API_KEY=
# Optional overrides (defaults shown):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-nano-3-30b-a3b
# NVIDIA_FALLBACK_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (for emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
