{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preecode: Compile Extension",
      "type": "npm",
      "script": "compile",
      "path": "preecode-extension",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      // Opens the Extension Development Host as a normal VS Code window, without
      // the paused `--inspect-brk` extension-host inspector that the `extensionHost`
      // debug type forces (and that fails to attach to here).
      "label": "Preecode: Open Extension Development Host",
      "type": "shell",
      "command": "code",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/preecode-extension"
      ],
      "problemMatcher": []
    }
  ]
}
